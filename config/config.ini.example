[database]
host = localhost
port = 3306
user = root
password = <your_mysql_password>
database = cicms_db
use_sqlite_fallback = false
sqlite_db_path = database/cicms.db

[application]
app_name = Criminal Investigation and Case Management System
version = 1.0.0
theme = dark
auto_backup = true
backup_dir = database/backups

[logging]
log_level = INFO
log_file = logs/cicms.log

[security]
session_timeout_minutes = 60
min_password_length = 6
